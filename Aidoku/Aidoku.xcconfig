// base identifiers
APP_ID_PREFIX               = app.aidoku
APP_ID_SUFFIX               = Aidoku

PRODUCT_BUNDLE_IDENTIFIER   = $(APP_ID_PREFIX).$(APP_ID_SUFFIX)

// Fork: Clear upstream DEVELOPMENT_TEAM for free Apple ID / Personal Team builds.
DEVELOPMENT_TEAM            =

// Store build
// Dev / sideload build (leave flag 'CANONICAL_BUILD' undefined)
OTHER_SWIFT_FLAGS = $(inherited) -DCANONICAL_BUILD

// Fork: Optional untracked local overrides (kept at repo root outside Aidoku/ synchronized group).
#include? "../Local.xcconfig"
